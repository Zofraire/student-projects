# PostgreSQL credentials (used by docker-compose)
POSTGRES_USER=myuser
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=student_projects

# Database URL
# For Docker deployment (app connects to db service):
DATABASE_URL="postgresql://myuser:change-me-to-a-strong-password@db:5432/student_projects"
# For local development (host connects to exposed port):
# DATABASE_URL="postgresql://myuser:change-me-to-a-strong-password@localhost:5433/student_projects"

# NextAuth — generate a secret with: openssl rand -hex 32
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
